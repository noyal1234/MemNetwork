{
  "version": 1,
  "project_roots": ["."],
  "budget": {
    "total_tokens": 1500,
    "dynamic_reallocation": true,
    "pack_quotas": {
      "enabled": true,
      "neurons_fraction": 0.4,
      "graph_fraction": 0.4,
      "procedures_fraction": 0.2
    },
    "session_start": {
      "pinned_rules": 300,
      "session_status": 150,
      "procedure_stubs": 60,
      "recall_top": 200
    },
    "pre_tool": {
      "procedure_expanded": 250,
      "graph_neighborhood": 400
    }
  },
  "graph": {
    "max_bfs_fanout_per_hop": 50,
    "max_activation_nodes": 500,
    "min_edge_weight_to_traverse": 0.3
  },
  "capture": {
    "transcripts": true,
    "plan_files": true,
    "plan_glob": ".cursor/plans/*.plan.md",
    "distill_mode": "cursor",
    "max_auto_neurons_per_session": 50,
    "max_neurons_per_plan": 20,
    "auto_observe": false,
    "observe_max_per_session": 40,
    "observe_dedup_window_seconds": 300,
    "observe_max_body_tokens": 80,
    "observation_ttl_hours": 72,
    "cloud_distill_acknowledged": false,
    "auto_supersede_conflicts": false
  },
  "mcp": {
    "transport": "stdio",
    "http_host": "127.0.0.1",
    "http_port": 8765,
    "allow_remote": false
  },
  "ollama": {
    "base_url": "http://127.0.0.1:11434",
    "model": "qwen2.5:3b",
    "auto_select_model": false,
    "timeout_seconds": 120
  },
  "groq": {
    "base_url": "https://api.groq.com/openai/v1",
    "model": "llama-3.3-70b-versatile",
    "timeout_seconds": 60
  },
  "injection": {
    "session_start": true,
    "pre_tool_patterns": ["write", "edit"],
    "max_recalls_per_turn": 3,
    "frozen_snapshot": true
  },
  "learning": {
    "co_activation_threshold": 3,
    "max_tool_nodes": 20,
    "auto_capture_confidence": 0.5,
    "session_window_size": 20,
    "co_activation_delta": 1.0,
    "co_activation_max_weight": 10.0,
    "co_activation_idle_days": 30,
    "co_activation_decay_factor": 0.5,
    "co_activation_min_weight": 0.3,
    "promote_max_ignore_rate": 0.5,
    "promote_min_injected_count": 3,
    "archive_min_injected_count": 5,
    "promote_ignore_half_life_days": 60,
    "session_state_retention_days": 14
  },
  "recall": {
    "abstain_on_low_confidence": true,
    "abstain_mode": "percentile",
    "abstain_percentile": 0.10,
    "min_recall_score": null,
    "max_per_session": 3,
    "include_sources": false,
    "activation": "ppr"
  },
  "handover": {
    "precompact_enabled": true,
    "precompact_distill_timeout_seconds": 30,
    "export_markdown": true
  },
  "graphify": {
    "enabled": true,
    "output_dir": "graphify-out",
    "graph_json": "graphify-out/graph.json",
    "code_only": true,
    "extract_binary": "graphify",
    "extract_extra_args": [],
    "extract_scope": "project_roots",
    "extract_timeout_seconds": 300,
    "sync_on_install": true,
    "auto_sync": {
      "enabled": true,
      "debounce_seconds": 60,
      "min_interval_seconds": 300,
      "trigger_on_post_tool": true,
      "watch_filesystem": false
    }
  },
  "viz": {
    "webllm_model": "Llama-3.2-1B-Instruct-q4f16_1-MLC",
    "webllm_prefetch": true
  },
  "semantic": {
    "enabled": false,
    "prefer_onnx": true,
    "embed_on_write": true
  },
  "compression": {
    "write_time": true,
    "max_body_tokens": 120,
    "pack_dedup": true,
    "pack_diversity": true,
    "summary_first": true,
    "pipeline_enabled": true,
    "rtk_lite_enabled": true,
    "prose_intensity": "lite",
    "inflation_guard": true,
    "session_dedup": true,
    "engine_version": "1",
    "canary_pct": 0.0,
    "decision_egress_lossy": false,
    "llmlingua_enabled": false,
    "cache_ttl_seconds": 300
  },
  "decay": {
    "enabled": true,
    "unused_days": 90,
    "consolidate_on_session_end": false
  },
  "git": {
    "enabled": false,
    "link_on_capture": true,
    "commit_trace": true,
    "commit_retention_days": 90
  },
  "team": { "auto_import_on_install": true, "team_dir": "team" }
}
