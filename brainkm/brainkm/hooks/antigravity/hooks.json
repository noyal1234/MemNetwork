{
  "brainkm": {
    "enabled": true,
    "SessionStart": [
      {
        "type": "command",
        "command": "brainkm pre-invocation --stdin --event SessionStart --client antigravity",
        "timeout": 30
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "brainkm pre-invocation --stdin --event PreInvocation --client antigravity",
        "timeout": 30
      }
    ],
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "brainkm pre-tool --stdin --event PreToolUse --client antigravity",
            "timeout": 15
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|multi_replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "brainkm post-tool --stdin --event PostToolUse --client antigravity",
            "timeout": 5
          }
        ]
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "brainkm agent-stop --stdin --event Stop --client antigravity",
        "timeout": 120
      }
    ]
  }
}
