{
  "version": 1,
  "id": "retrieval_v1",
  "description": "Held-out IR ranking eval: Recall@k / MRR / nDCG on ephemeral gold corpus",
  "floors": {
    "recall_at_5": 0.55,
    "recall_at_1": 0.4,
    "precision_at_1": 0.35,
    "precision_at_5": 0.20,
    "mrr": 0.45,
    "ndcg_at_5": 0.5,
    "abstain_accuracy": 0.85,
    "theme_leak_accuracy": 0.9
  },
  "corpus": [
    {
      "id": "rb_budget_policy",
      "kind": "memory",
      "subtype": "decision",
      "title": "Token budget greedy truncate",
      "content": "greedy_truncate keeps highest-priority neurons under total_tokens cap of 1500"
    },
    {
      "id": "rb_budget_tiktoken",
      "kind": "memory",
      "subtype": "fact",
      "title": "tiktoken budget counting",
      "content": "token_count uses tiktoken encoding for budget enforcement"
    },
    {
      "id": "rb_budget_slots",
      "kind": "memory",
      "subtype": "fact",
      "title": "Per-channel budget slots",
      "content": "context_pack allocates memory code and procedure slots with dynamic reallocation"
    },
    {
      "id": "rb_wal_rule",
      "kind": "memory",
      "subtype": "rule",
      "title": "PreCompact WAL checkpoint",
      "content": "Run PRAGMA wal_checkpoint FULL before handover to prevent stale pages"
    },
    {
      "id": "rb_wal_mode",
      "kind": "memory",
      "subtype": "fact",
      "title": "SQLite WAL mode",
      "content": "brain.db uses WAL mode with single-writer WriteQueue for MCP"
    },
    {
      "id": "rb_wal_busy",
      "kind": "memory",
      "subtype": "error",
      "title": "WAL checkpoint busy",
      "content": "handover failed when wal_checkpoint returned SQLITE_BUSY"
    },
    {
      "id": "rb_graph_import",
      "kind": "memory",
      "subtype": "fact",
      "title": "Graphify graph.json import",
      "content": "graph_import loads graphify-out graph.json into SQLite code nodes"
    },
    {
      "id": "rb_graph_routing",
      "kind": "memory",
      "subtype": "decision",
      "title": "Graphify vs codebase routing",
      "content": "Locate with Cursor codebase; flow and blast radius use traverse and context_pack"
    },
    {
      "id": "rb_graph_autosync",
      "kind": "memory",
      "subtype": "rule",
      "title": "Graphify auto sync debounce",
      "content": "PostToolUse Write Edit touches graph_sync.requested for debounced MCP sync"
    },
    {
      "id": "rb_mcp_dispatch",
      "kind": "memory",
      "subtype": "rule",
      "title": "MCP dispatch pattern",
      "content": "tools delegate to services; validate with Pydantic at entry never skip layers"
    },
    {
      "id": "rb_mcp_resources",
      "kind": "memory",
      "subtype": "fact",
      "title": "MCP resources and HTTP",
      "content": "server exposes MCP resources and optional HTTP transport besides stdio"
    },
    {
      "id": "rb_mcp_output",
      "kind": "memory",
      "subtype": "fact",
      "title": "Typed MCP outputSchema",
      "content": "TOOL_DEFINITIONS register request and response models for outputSchema"
    },
    {
      "id": "rb_hook_snapshot",
      "kind": "memory",
      "subtype": "decision",
      "title": "Frozen SessionStart snapshot",
      "content": "SessionStart builds frozen snapshot; mid-session remember does not mutate injection"
    },
    {
      "id": "rb_hook_handover",
      "kind": "memory",
      "subtype": "rule",
      "title": "PreCompact handover",
      "content": "PreCompact hook runs brainkm handover before Cursor compaction"
    },
    {
      "id": "rb_hook_capture",
      "kind": "memory",
      "subtype": "pattern",
      "title": "SessionEnd capture distill",
      "content": "SessionEnd distills transcripts into neurons via rules cursor or ollama"
    },
    {
      "id": "rb_abs_percentile",
      "kind": "memory",
      "subtype": "rule",
      "title": "Recall abstention percentile",
      "content": "Return empty when BM25 below calibrated corpus percentile threshold"
    },
    {
      "id": "rb_abs_min_score",
      "kind": "memory",
      "subtype": "fact",
      "title": "min_recall_score threshold",
      "content": "RecallConfig.min_recall_score gates low confidence hits"
    },
    {
      "id": "rb_abs_max_turn",
      "kind": "memory",
      "subtype": "rule",
      "title": "Max recalls per turn",
      "content": "max_recalls_per_turn defaults to 3 unless truncation_followup"
    },
    {
      "id": "rb_distill_modes",
      "kind": "memory",
      "subtype": "fact",
      "title": "Distill mode matrix",
      "content": "Supported distill modes are cursor rules ollama groq and mcp sampling"
    },
    {
      "id": "rb_distill_redact",
      "kind": "memory",
      "subtype": "rule",
      "title": "Redact before remember",
      "content": "All neuron writes funnel through remember_neuron redaction and injection scan"
    },
    {
      "id": "rb_distill_claude",
      "kind": "memory",
      "subtype": "fact",
      "title": "Claude JSONL capture",
      "content": "Claude Code transcripts are JSONL and use the claude capture adapter"
    },
    {
      "id": "rb_sem_onnx",
      "kind": "memory",
      "subtype": "fact",
      "title": "ONNX MiniLM embeddings",
      "content": "Optional semantic extra uses ONNX MiniLM for hybrid RRF retrieval"
    },
    {
      "id": "rb_sem_rerank",
      "kind": "memory",
      "subtype": "fact",
      "title": "Cross-encoder rerank",
      "content": "Optional CE reranker reorders candidates after hybrid retrieval"
    },
    {
      "id": "rb_sem_consent",
      "kind": "memory",
      "subtype": "decision",
      "title": "Semantic Quality consent",
      "content": "Wizard Semantic Quality consent required before enabling embeddings"
    },
    {
      "id": "rb_learn_coact",
      "kind": "memory",
      "subtype": "pattern",
      "title": "Co-activation learning",
      "content": "co_activated edges increment when neurons appear together in the session window"
    },
    {
      "id": "rb_learn_proc",
      "kind": "memory",
      "subtype": "fact",
      "title": "Procedure promotion",
      "content": "Procedures promote when co-activation exceeds threshold with two external tools"
    },
    {
      "id": "rb_learn_decay",
      "kind": "memory",
      "subtype": "rule",
      "title": "Neuron decay consolidate",
      "content": "Unused neurons decay; consolidate merges near-duplicate memories"
    },
    {
      "id": "rb_temp_old_auth",
      "kind": "memory",
      "subtype": "decision",
      "title": "Auth sessions cookie old",
      "content": "We used server sessions with cookies for auth historically"
    },
    {
      "id": "rb_temp_new_jwt",
      "kind": "memory",
      "subtype": "decision",
      "title": "Auth JWT supersede",
      "content": "We superseded cookies with JWT access tokens fifteen minute expiry"
    },
    {
      "id": "rb_temp_old_bfs",
      "kind": "memory",
      "subtype": "fact",
      "title": "Flat BFS activation old",
      "content": "Activation used flat two-hop BFS before PPR"
    },
    {
      "id": "rb_temp_new_ppr",
      "kind": "memory",
      "subtype": "fact",
      "title": "Weighted PPR activation",
      "content": "Activation now uses weighted personalized PageRank by default"
    },
    {
      "id": "rb_noise_k8s",
      "kind": "memory",
      "subtype": "fact",
      "title": "Kubernetes ingress TLS",
      "content": "Cluster ingress terminates TLS with cert-manager certificates"
    },
    {
      "id": "rb_noise_weather",
      "kind": "memory",
      "subtype": "fact",
      "title": "Weather rainfall forecast",
      "content": "Tomorrow rainfall probability is forty percent coastal"
    },
    {
      "id": "rb_noise_gpu",
      "kind": "memory",
      "subtype": "fact",
      "title": "GPU cluster training",
      "content": "Machine learning training uses eight A100 GPUs"
    },
    {
      "id": "rb_noise_banana",
      "kind": "memory",
      "subtype": "fact",
      "title": "Quantum banana reactor",
      "content": "Quantum banana reactor flux capacitor needs shielding"
    },
    {
      "id": "rb_noise_payroll",
      "kind": "memory",
      "subtype": "fact",
      "title": "Payroll tax filing",
      "content": "Quarterly payroll taxes file by the fifteenth"
    }
  ],
