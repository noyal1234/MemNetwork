/* ──────────────────────────────────────────────────────────────────
   brainkm configure — Textual CSS
   Cyber-Industrial (DESIGN.md) — violet/obsidian, true red errors
   ────────────────────────────────────────────────────────────────── */

/* === Design tokens (dark theme — default) === */

$primary: #d2bbff;
$primary-container: #7c3aed;
$primary-muted: #5a00c6;
$primary-light: #d2bbff;
$success: #4ae176;
$warning: #ffb95f;
$accent: #FFB000;
$error: #ef4444;
$surface: #15121b;
$surface-alt: #1d1a24;
$surface-container: #221e28;
$surface-high: #2c2833;
$text: #e8dfee;
/* Farther from $text so labels/secondary copy read as hierarchy. */
$text-muted: #9a91a8;
$outline: #958da1;
$border: #4a4455;

/* === Global === */

Screen {
    background: $surface;
    color: $text;
}

/* === Header === */

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
    /* height must leave room for content: solid border eats 1 row */
    height: 2;
    border-bottom: solid $border;
}

/* === Footer === */

Footer {
    background: $surface;
    color: $outline;
    /* Same pitfall as compact Buttons: default height:1 + border
       eats the only row and blanks the keybinding helper line. */
    height: 2;
    border-top: solid $border;
}

FooterKey {
    background: transparent;
    color: $outline;
}

FooterKey > .footer-key--key {
    color: $primary;
    text-style: bold;
}

FooterKey > .footer-key--description {
    color: $text-muted;
}

FooterKey:hover {
    color: $primary;
    background: $surface-high;
}

FooterKey.-highlight {
    background: $success;
    color: $surface;
    text-style: bold;
}

Footer > .footer--highlight {
    background: $success;
    color: $surface;
}

/* === Status panels === */

.status-panel {
    border: round $border;
    padding: 1 1;
    margin: 0 0 1 0;
    background: $surface-alt;
    height: auto;
}

.status-panel:focus-within {
    border: round $primary;
}

.status-panel.emphasized {
    border: round $primary-container;
    background: $surface-high;
}

.status-panel.-loading {
    opacity: 0.75;
}

.status-panel .panel-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    height: 1;
}

.status-panel .status-row {
    height: 1;
    width: 100%;
    layout: horizontal;
}

.status-panel .status-label {
    width: 15;
    color: $text-muted;
    text-wrap: nowrap;
    overflow-x: hidden;
    text-overflow: ellipsis;
    padding: 0 1 0 0;
}

.status-panel .status-glyph {
    width: 2;
    text-align: left;
}

.status-panel .status-value {
    width: 1fr;
    height: 1;
    text-wrap: nowrap;
    overflow-x: hidden;
    text-overflow: ellipsis;
}

.status-panel .value--ok {
    color: $success;
    text-style: bold;
}

.status-panel .value--warning {
    color: $warning;
    text-style: bold;
}

.status-panel .value--accent {
    color: $accent;
    text-style: bold;
}

.status-panel .value--error {
    color: $error;
    text-style: bold;
}

.status-panel .value--muted {
    color: $text-muted;
}

.status-panel .panel-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: left middle;
}

.status-panel .panel-actions Button {
    margin: 0 1 0 0;
    min-width: 10;
    height: 3;
}

/* === Dashboard layout === */

#dashboard-container {
    layout: vertical;
    height: 1fr;
    padding: 1 1;
    overflow-y: auto;
}

#rate-limit-banner {
    display: none;
    height: auto;
    min-height: 1;
    margin: 0 0 1 0;
    padding: 0 1;
    color: $error;
    text-style: bold;
    background: $surface-high;
    border: solid $error;
}

#rate-limit-banner.visible {
    display: block;
}

#dashboard-body {
    layout: horizontal;
    height: auto;
    min-height: 100%;
}

#status-sidebar {
    width: 40;
    min-width: 36;
    height: auto;
    min-height: 100%;
    padding: 0 1 0 0;
}

#status-sidebar .status-panel {
    height: auto;
    min-height: 100%;
    margin: 0;
}

#dashboard-main {
    layout: vertical;
    width: 1fr;
    height: auto;
    min-height: 100%;
    padding: 0 0 0 1;
}

#doctor-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

#doctor-row .doctor-col {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

#doctor-row .doctor-col:last-child {
    margin-right: 0;
}

#doctor-row .doctor-col .status-panel {
    width: 100%;
    margin: 0;
}

#doctor-row .panel-actions {
    layout: horizontal;
    height: 1;
    margin-top: 0;
    align: left middle;
}

#doctor-row .panel-actions Button {
    margin: 0 1 0 0;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0 1;
}

#doctor-row .panel-actions Button:hover,
#doctor-row .panel-actions Button:focus {
    border: none;
}

#graph-section {
    layout: vertical;
    height: auto;
    border: solid $border;
    background: $surface-alt;
    padding: 1 1;
    margin: 0 0 1 0;
}

#graph-section .section-header {
    layout: horizontal;
    height: 1;
    align: left middle;
}

#graph-section .section-title {
    text-style: bold;
    color: $success;
    width: 1fr;
}

#graph-section .graph-actions {
    layout: horizontal;
    width: auto;
    height: 1;
}

#graph-section .graph-actions Button {
    margin: 0 0 0 1;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0 1;
}

#graph-section .graph-actions Button:hover,
#graph-section .graph-actions Button:focus {
    border: none;
}

#graph-section #graph-panel {
    border: none;
    margin: 0;
    padding: 0;
    background: transparent;
}

#mcp-doctor-section {
    layout: vertical;
    height: auto;
    border: solid $border;
    background: $surface-alt;
    padding: 1 1;
    margin: 0 0 1 0;
}

#mcp-doctor-section .section-header {
    layout: horizontal;
    height: 1;
    align: left middle;
}

#mcp-doctor-section .section-title {
    text-style: bold;
    color: $primary;
    width: 1fr;
}

#mcp-doctor-section .graph-actions {
    layout: horizontal;
    width: auto;
    height: 1;
}

#mcp-doctor-section .graph-actions Button {
    margin: 0 0 0 1;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0 1;
}

#mcp-doctor-section .graph-actions Button:hover,
#mcp-doctor-section .graph-actions Button:focus {
    border: none;
}

#mcp-doctor-section #mcp-doctor-panel {
    border: none;
    margin: 0;
    padding: 0;
    background: transparent;
    height: auto;
}

#review-section {
    layout: vertical;
    height: auto;
    min-height: 12;
    border: solid $border;
    background: $surface-alt;
    padding: 0;
    margin: 0;
}

#review-section.review-section--empty {
    min-height: 5;
}

#review-section.review-section--empty #review-table {
    min-height: 3;
    max-height: 6;
}

#review-section .review-header {
    layout: horizontal;
    height: 1;
    background: $surface-high;
    padding: 0 1;
}

#review-section .review-title {
    text-style: bold;
    color: $text-muted;
    width: 1fr;
}

#review-section .review-hint {
    color: $warning;
    text-align: right;
    width: auto;
}

#review-section #review-table {
    height: auto;
    min-height: 8;
    padding: 0 1;
}

#review-table .review-empty {
    color: $text-muted;
    height: 1;
    padding: 1 0;
    text-align: left;
}

#review-table DataTable.hidden {
    display: none;
}

/* === Rich log panel === */

.rich-log-panel {
    border: solid $border;
    background: $surface-alt;
    margin: 1 0;
    padding: 0 1 1 1;
    height: 1fr;
    min-height: 12;
}

.rich-log-panel .log-title {
    text-style: bold;
    color: $primary;
    height: 1;
    padding: 0 0 1 0;
}

.rich-log-panel RichLog {
    height: 1fr;
    min-height: 10;
    background: $surface;
    color: $text;
    border: none;
}

/* === Config editor === */

/* Fill space between Header and Footer; Save sits in-flow (not docked)
   so short terminals keep the button row visible above the Footer. */
#config-layout {
    layout: vertical;
    height: 1fr;
    width: 100%;
}

#config-container {
    layout: vertical;
    overflow-y: auto;
    padding: 1 2;
    height: 1fr;
    min-height: 5;
}

/* Must be content-sized: the default Vertical height (1fr) fills the
   viewport and clips later sections (Ollama, Groq, Budget, …) so they
   never enter the scrollable content height. */
#config-forms {
    layout: vertical;
    height: auto;
    width: 100%;
}

.config-section {
    border: solid $border;
    background: $surface-alt;
    padding: 1 2;
    margin: 1 0;
    height: auto;
    width: 100%;
}

.config-section .section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.config-field {
    layout: vertical;
    height: auto;
    margin: 0 0 1 0;
}

.config-field-row {
    layout: horizontal;
    height: auto;
    min-height: 3;
}

.config-field-row .field-label,
.config-field Label {
    width: 28;
    padding: 1 1 0 0;
    color: $text;
}

.config-field-row Input,
.config-field Input {
    width: 1fr;
}

.config-field-row Select,
.config-field Select {
    width: 1fr;
    min-height: 3;
}

.config-field-row Switch,
.config-field Switch {
    width: auto;
    margin: 1 0 0 0;
}

.field-help {
    color: $text-muted;
    height: auto;
    margin: 0 0 0 28;
}

.api-key-status {
    margin: 0 0 1 0;
    padding: 0 1;
}

.validation-ok {
    color: $success;
    text-style: bold;
    margin: 1 0;
}

.validation-error {
    color: $error;
    margin: 1 0;
}

#config-buttons {
    /* height 4 = 3 for Buttons + 1 eaten by border-top (same Header/Footer pitfall). */
    height: 4;
    width: 100%;
    layout: horizontal;
    padding: 0 2;
    background: $surface;
    border-top: solid $border;
}

#config-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* === Actions screen === */

#actions-container {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

.action-buttons-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.action-buttons-row Button {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
}

#action-log {
    height: 1fr;
    min-height: 12;
}

/* === Wizard screen === */

#wizard-container {
    layout: vertical;
    height: 1fr;
    padding: 1 2;
    overflow-y: auto;
}

.wizard-progress {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

.wizard-step {
    /* Keep padding small: border + large padding can leave 0 content rows
       (same pitfall as Header/Footer height:1 + border). */
    height: auto;
    border: round $border;
    background: $surface-alt;
    padding: 1 2;
    margin: 0 0 1 0;
}

.wizard-step.wizard-step--active {
    background: $surface-high;
    border: round $primary-container;
}

.wizard-step .step-title {
    text-style: bold;
    color: $primary;
    height: 1;
    margin-bottom: 0;
}

.wizard-step .step-description {
    color: $text-muted;
    height: auto;
    margin-bottom: 0;
}

#wizard-container #wizard-log {
    /* Don't let the log steal the whole viewport from the steps. */
    height: 10;
    min-height: 8;
    max-height: 12;
}

#wizard-nav {
    height: 3;
    layout: horizontal;
    padding: 1 0 0 0;
    align: left middle;
}

#wizard-nav Button {
    margin: 0 1;
    min-width: 14;
    /* Border eats the label row when height is 1 — match dashboard compact buttons. */
    height: 1;
    border: none;
    padding: 0 1;
}

#wizard-nav Button:hover,
#wizard-nav Button:focus {
    border: none;
}

/* === Shared panel titles (Actions / Config / Wizard) === */

.panel-title {
    text-style: bold;
    color: $primary;
    height: 1;
    margin-bottom: 1;
}

/* === Buttons ===
   Resting state stays quiet so status values remain the loudest elements.
   Purple fill is reserved for focus / primary / active. */

Button {
    background: $surface-container;
    color: $text-muted;
    border: tall $border;
    min-width: 10;
}

Button:hover {
    background: $surface-high;
    color: $text;
    border: tall $outline;
}

Button:focus {
    background: $primary-container;
    color: $text;
    border: tall $primary;
    text-style: bold;
}

Button.-primary {
    background: $primary-muted;
    color: $text;
    text-style: bold;
    border: tall $primary-container;
}

Button.-primary:hover,
Button.-primary:focus {
    background: $primary-container;
    color: $text;
    border: tall $primary;
}

Button.-success {
    background: $success;
    color: $surface;
    text-style: bold;
    border: tall $success;
}

Button.-error {
    background: $error;
    color: $text;
    text-style: bold;
    border: tall $error;
}

Button:disabled {
    background: $surface-container;
    color: $outline;
    border: tall $border;
}

/* === DataTable === */

DataTable {
    margin: 0;
    height: 1fr;
    background: $surface-alt;
}

DataTable > .datatable--header {
    background: $surface-high;
    color: $outline;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-muted;
    color: $text;
}

DataTable > .datatable--hover {
    background: $surface-high;
    color: $text;
}

/* === Input === */

Input {
    background: $surface;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: solid $primary;
}

/* === Select === */

Select {
    background: $surface;
    color: $text;
    border: solid $border;
}

Select:focus {
    border: solid $primary;
}

/* === Switch === */

Switch {
    background: $surface;
}

Switch:focus {
    background: $surface-high;
}

/* === Toast === */

Toast {
    background: $surface-alt;
    color: $text;
    border: solid $border;
}

/* === Command palette / OptionList (theme stock Textual blue away) === */

OptionList > .option-list--option-highlighted {
    background: $primary-container;
    color: $text;
    text-style: bold;
}

/* === Config sections focus === */

.config-section:focus-within {
    border: solid $primary;
}

/* === Confirm discard modal === */

ConfirmDiscardModal {
    align: center middle;
}

ConfirmDiscardModal #confirm-discard-box {
    width: 56;
    height: auto;
    border: solid $primary-container;
    background: $surface-alt;
    padding: 1 2;
}

ConfirmDiscardModal .modal-title {
    text-style: bold;
    color: $warning;
    height: 1;
    margin-bottom: 1;
}

ConfirmDiscardModal .modal-body {
    color: $text;
    height: auto;
    margin-bottom: 1;
}

ConfirmDiscardModal .modal-buttons {
    layout: horizontal;
    height: 3;
    align: right middle;
}

ConfirmDiscardModal .modal-buttons Button {
    margin: 0 0 0 1;
    min-width: 12;
}

/* === Review detail modal === */

ReviewDetailModal {
    align: center middle;
}

ReviewDetailModal #review-detail-box {
    width: 72;
    max-width: 90%;
    height: auto;
    max-height: 80%;
    border: solid $primary-container;
    background: $surface-alt;
    padding: 1 2;
}

ReviewDetailModal .modal-title {
    text-style: bold;
    color: $warning;
    height: 1;
    margin-bottom: 1;
}

ReviewDetailModal .modal-meta {
    color: $text-muted;
    height: auto;
    margin-bottom: 1;
}

ReviewDetailModal .modal-title-line {
    color: $text;
    text-style: bold;
    height: auto;
    margin-bottom: 1;
}

ReviewDetailModal #review-detail-body-scroll {
    height: 12;
    max-height: 16;
    border: solid $border;
    background: $surface;
    padding: 0 1;
    margin-bottom: 1;
}

ReviewDetailModal .modal-body {
    color: $text;
    height: auto;
}

ReviewDetailModal .modal-hint {
    color: $text-muted;
    height: 1;
    margin-bottom: 1;
}

ReviewDetailModal .modal-buttons {
    layout: horizontal;
    height: 3;
    align: right middle;
}

ReviewDetailModal .modal-buttons Button {
    margin: 0 0 0 1;
    min-width: 12;
}
