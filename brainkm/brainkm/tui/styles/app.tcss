/* ──────────────────────────────────────────────────────────────────
   brainkm configure — Textual CSS
   Cyber-Industrial (DESIGN.md) — violet/obsidian, true red errors
   ────────────────────────────────────────────────────────────────── */

/* === Design tokens (dark theme — default) === */

$primary: #d2bbff;
$primary-container: #7c3aed;
$primary-muted: #5a00c6;
$primary-light: #d2bbff;
$success: #4ae176;
$warning: #ffb95f;
$error: #ef4444;
$surface: #15121b;
$surface-alt: #1d1a24;
$surface-container: #221e28;
$surface-high: #2c2833;
$text: #e8dfee;
$text-muted: #ccc3d8;
$outline: #958da1;
$border: #4a4455;
$accent: #d2bbff;

/* === Global === */

Screen {
    background: $surface;
    color: $text;
}

/* === Header === */

Header {
    background: $surface;
    color: $primary;
    text-style: bold;
    /* height must leave room for content: solid border eats 1 row */
    height: 2;
    border-bottom: solid $border;
}

/* === Footer === */

Footer {
    background: $surface;
    color: $outline;
    /* Same pitfall as compact Buttons: default height:1 + border
       eats the only row and blanks the keybinding helper line. */
    height: 2;
    border-top: solid $border;
}

FooterKey {
    background: transparent;
    color: $outline;
}

FooterKey > .footer-key--key {
    color: $primary;
    text-style: bold;
}

FooterKey > .footer-key--description {
    color: $text-muted;
}

FooterKey:hover {
    color: $primary;
    background: $surface-high;
}

FooterKey.-highlight {
    background: $success;
    color: $surface;
    text-style: bold;
}

Footer > .footer--highlight {
    background: $success;
    color: $surface;
}

/* === Status panels === */

.status-panel {
    border: solid $border;
    padding: 1 1;
    margin: 0 0 1 0;
    background: $surface-alt;
    height: auto;
}

.status-panel.emphasized {
    border: solid $primary-container;
    background: $surface-high;
}

.status-panel .panel-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
    height: 1;
}

.status-panel .value--ok {
    color: $success;
    text-style: bold;
}

.status-panel .value--warning {
    color: $warning;
    text-style: bold;
}

.status-panel .value--error {
    color: $error;
    text-style: bold;
}

.status-panel .value--muted {
    color: $text-muted;
}

.status-panel .status-row {
    height: 1;
}

.status-panel .status-label {
    width: 18;
    color: $text-muted;
}

.status-panel .status-value {
    width: 1fr;
}

.status-panel .panel-actions {
    layout: horizontal;
    height: 3;
    margin-top: 1;
    align: left middle;
}

.status-panel .panel-actions Button {
    margin: 0 1 0 0;
    min-width: 10;
    height: 3;
}

/* === Dashboard layout === */

#dashboard-container {
    layout: vertical;
    height: 1fr;
    padding: 1 1;
}

#dashboard-body {
    layout: horizontal;
    height: 1fr;
}

#status-sidebar {
    width: 32;
    min-width: 28;
    height: 1fr;
    padding: 0 1 0 0;
}

#status-sidebar .status-panel {
    height: 1fr;
    margin: 0;
}

#dashboard-main {
    layout: vertical;
    width: 1fr;
    height: 1fr;
    padding: 0 0 0 1;
}

#doctor-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

#doctor-row .doctor-col {
    width: 1fr;
    height: auto;
    margin: 0 1 0 0;
}

#doctor-row .doctor-col:last-child {
    margin-right: 0;
}

#doctor-row .doctor-col .status-panel {
    width: 100%;
    margin: 0;
}

#doctor-row .panel-actions {
    layout: horizontal;
    height: 1;
    margin-top: 0;
    align: left middle;
}

#doctor-row .panel-actions Button {
    margin: 0 1 0 0;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0 1;
}

#doctor-row .panel-actions Button:hover,
#doctor-row .panel-actions Button:focus {
    border: none;
}

#graph-section {
    layout: vertical;
    height: auto;
    border: solid $border;
    background: $surface-alt;
    padding: 1 1;
    margin: 0 0 1 0;
}

#graph-section .section-header {
    layout: horizontal;
    height: 1;
    align: left middle;
}

#graph-section .section-title {
    text-style: bold;
    color: $success;
    width: 1fr;
}

#graph-section .graph-actions {
    layout: horizontal;
    width: auto;
    height: 1;
}

#graph-section .graph-actions Button {
    margin: 0 0 0 1;
    min-width: 10;
    height: 1;
    border: none;
    padding: 0 1;
}

#graph-section .graph-actions Button:hover,
#graph-section .graph-actions Button:focus {
    border: none;
}

#graph-section #graph-panel {
    border: none;
    margin: 0;
    padding: 0;
    background: transparent;
}

#review-section {
    layout: vertical;
    height: 1fr;
    border: solid $border;
    background: $surface-alt;
    padding: 0;
    margin: 0;
}

#review-section .review-header {
    layout: horizontal;
    height: 1;
    background: $surface-high;
    padding: 0 1;
}

#review-section .review-title {
    text-style: bold;
    color: $text-muted;
    width: 1fr;
}

#review-section .review-hint {
    color: $warning;
    text-align: right;
    width: auto;
}

#review-section #review-table {
    height: 1fr;
    padding: 0 1;
}

/* === Rich log panel === */

.rich-log-panel {
    border: solid $border;
    background: $surface-alt;
    margin: 1 0;
    padding: 0 1 1 1;
    height: 1fr;
    min-height: 12;
}

.rich-log-panel .log-title {
    text-style: bold;
    color: $primary;
    height: 1;
    padding: 0 0 1 0;
}

.rich-log-panel RichLog {
    height: 1fr;
    min-height: 10;
    background: $surface;
    color: $text;
    border: none;
}

/* === Config editor === */

#config-container {
    layout: vertical;
    overflow-y: auto;
    padding: 1 2;
    height: 1fr;
}

.config-section {
    border: solid $border;
    background: $surface-alt;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}

.config-section .section-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.config-field {
    layout: vertical;
    height: auto;
    margin: 0 0 1 0;
}

.config-field-row {
    layout: horizontal;
    height: auto;
    min-height: 3;
}

.config-field-row .field-label,
.config-field Label {
    width: 28;
    padding: 1 1 0 0;
    color: $text;
}

.config-field-row Input,
.config-field Input {
    width: 1fr;
}

.config-field-row Select,
.config-field Select {
    width: 1fr;
    min-height: 3;
}

.config-field-row Switch,
.config-field Switch {
    width: auto;
    margin: 1 0 0 0;
}

.field-help {
    color: $text-muted;
    height: auto;
    margin: 0 0 0 28;
}

.api-key-status {
    margin: 0 0 1 0;
    padding: 0 1;
}

.validation-ok {
    color: $success;
    text-style: bold;
    margin: 1 0;
}

.validation-error {
    color: $error;
    margin: 1 0;
}

#config-buttons {
    dock: bottom;
    height: 3;
    layout: horizontal;
    padding: 0 2;
    background: $surface;
    border-top: solid $border;
}

#config-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* === Actions screen === */

#actions-container {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

.action-buttons-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.action-buttons-row Button {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
}

#action-log {
    height: 1fr;
    min-height: 12;
}

/* === Wizard screen === */

#wizard-container {
    layout: vertical;
    padding: 2 4;
    overflow-y: auto;
}

.wizard-step {
    border: solid $border;
    background: $surface-alt;
    padding: 2 3;
    margin: 1 0;
}

.wizard-step .step-title {
    text-style: bold;
    color: $primary;
    margin-bottom: 1;
}

.wizard-step .step-description {
    color: $text-muted;
    margin-bottom: 1;
}

#wizard-nav {
    dock: bottom;
    height: 3;
    layout: horizontal;
    padding: 0 4;
    background: $surface;
    border-top: solid $border;
}

#wizard-nav Button {
    margin: 0 1;
    min-width: 14;
}

/* === Shared panel titles (Actions / Config / Wizard) === */

.panel-title {
    text-style: bold;
    color: $primary;
    height: 1;
    margin-bottom: 1;
}

/* === Buttons === */

Button {
    background: $surface-high;
    color: $primary;
    border: solid $border;
    min-width: 10;
}

Button:hover {
    background: $primary-container;
    color: $text;
    border: solid $primary;
}

Button:focus {
    border: solid $primary;
    text-style: bold;
}

Button.-primary {
    background: $primary-container;
    color: $text;
    text-style: bold;
}

Button.-primary:hover {
    background: $primary;
    color: $surface;
}

Button.-success {
    background: $success;
    color: $surface;
    text-style: bold;
}

Button.-error {
    background: $error;
    color: white;
    text-style: bold;
}

Button:disabled {
    background: $surface-container;
    color: $outline;
    border: solid $border;
}

/* === DataTable === */

DataTable {
    margin: 0;
    height: 1fr;
    background: $surface-alt;
}

DataTable > .datatable--header {
    background: $surface-high;
    color: $outline;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary-container;
    color: $text;
}

/* === Input === */

Input {
    background: $surface;
    color: $text;
    border: solid $border;
}

Input:focus {
    border: solid $primary-container;
}

/* === Select === */

Select {
    background: $surface;
    color: $text;
    border: solid $border;
}

Select:focus {
    border: solid $primary-container;
}

/* === Switch === */

Switch {
    background: $surface;
}

/* === Tabs (screen navigation) === */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

Tabs {
    background: $surface-high;
    dock: top;
}

Tab {
    color: $text-muted;
    padding: 0 3;
}

Tab.-active {
    color: $text;
    text-style: bold;
    background: $primary-container;
}

Tab:hover {
    color: $text;
    background: $primary-container;
}

/* === Toast === */

Toast {
    background: $surface-alt;
    color: $text;
    border: solid $border;
}

/* === Help overlay === */

#help-overlay {
    align: center middle;
    width: 60;
    height: auto;
    max-height: 80%;
    background: $surface-alt;
    border: solid $primary-container;
    padding: 2 3;
    layer: overlay;
}

#help-overlay .help-title {
    text-style: bold;
    color: $primary;
    text-align: center;
    margin-bottom: 1;
}

#help-overlay DataTable {
    background: $surface-alt;
    max-height: 20;
}
