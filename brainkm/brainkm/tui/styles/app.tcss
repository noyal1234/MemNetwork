/* ──────────────────────────────────────────────────────────────────
   brainkm configure — Textual CSS
   ────────────────────────────────────────────────────────────────── */

/* === Design tokens (dark theme — default) === */

$primary: #7c3aed;
$primary-muted: #4c1d95;
$primary-light: #a78bfa;
$success: #22c55e;
$warning: #f59e0b;
$error: #ef4444;
$surface: #1e1b2e;
$surface-alt: #2d2640;
$text: #e2e0ea;
$text-muted: #8b83a0;
$border: #3f3663;
$accent: #c084fc;

/* === Global === */

Screen {
    background: $surface;
    color: $text;
}

/* === Header === */

#app-header {
    dock: top;
    height: 1;
    background: $primary;
    color: $text;
    text-style: bold;
    padding: 0 2;
}

#app-header .project-path {
    color: $primary-light;
    text-style: italic;
}

/* === Footer === */

Footer {
    background: $primary-muted;
}

/* === Status panels === */

.status-panel {
    border: round $border;
    padding: 1 2;
    margin: 1 2;
    background: $surface-alt;
    height: auto;
}

.status-panel .panel-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.status-panel .value--ok {
    color: $success;
    text-style: bold;
}

.status-panel .value--warning {
    color: $warning;
    text-style: bold;
}

.status-panel .value--error {
    color: $error;
    text-style: bold;
}

.status-panel .value--muted {
    color: $text-muted;
}

.status-panel .status-row {
    height: 1;
}

.status-panel .status-label {
    width: 18;
    color: $text-muted;
}

.status-panel .status-value {
    width: 1fr;
}

/* === Dashboard layout === */

#dashboard-container {
    layout: vertical;
    overflow-y: auto;
    padding: 0 1;
}

#brain-summary {
    layout: horizontal;
    height: auto;
    margin: 1 1;
}

#brain-summary .status-panel {
    width: 1fr;
}

#doctor-row {
    layout: horizontal;
    height: auto;
    margin: 0 1;
}

#doctor-row .status-panel {
    width: 1fr;
}

#graph-section {
    height: auto;
    margin: 0 1;
}

#review-section {
    height: auto;
    margin: 0 1;
}

/* === Rich log panel === */

.rich-log-panel {
    border: round $border;
    background: $surface-alt;
    margin: 1 0;
    padding: 0 1 1 1;
    height: 1fr;
    min-height: 12;
}

.rich-log-panel .log-title {
    text-style: bold;
    color: $accent;
    height: 1;
    padding: 0 0 1 0;
}

.rich-log-panel RichLog {
    height: 1fr;
    min-height: 10;
    background: $surface;
    color: $text;
    border: none;
}

/* === Config editor === */

#config-container {
    layout: vertical;
    overflow-y: auto;
    padding: 1 2;
    height: 1fr;
}

.config-section {
    border: round $border;
    background: $surface-alt;
    padding: 1 2;
    margin: 1 0;
    height: auto;
}

.config-section .section-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.config-field {
    layout: vertical;
    height: auto;
    margin: 0 0 1 0;
}

.config-field-row {
    layout: horizontal;
    height: auto;
    min-height: 3;
}

.config-field-row .field-label,
.config-field Label {
    width: 28;
    padding: 1 1 0 0;
    color: $text;
}

.config-field-row Input,
.config-field Input {
    width: 1fr;
}

.config-field-row Select,
.config-field Select {
    width: 1fr;
    min-height: 3;
}

.config-field-row Switch,
.config-field Switch {
    width: auto;
    margin: 1 0 0 0;
}

.field-help {
    color: $text-muted;
    height: auto;
    margin: 0 0 0 28;
}

.api-key-status {
    margin: 0 0 1 0;
    padding: 0 1;
}

.validation-ok {
    color: $success;
    text-style: bold;
    margin: 1 0;
}

.validation-error {
    color: $error;
    margin: 1 0;
}

#config-buttons {
    dock: bottom;
    height: 3;
    layout: horizontal;
    padding: 0 2;
    background: $surface;
}

#config-buttons Button {
    margin: 0 1;
    min-width: 12;
}

/* === Actions screen === */

#actions-container {
    layout: vertical;
    padding: 1 2;
    height: 1fr;
}

.action-buttons-row {
    layout: horizontal;
    height: auto;
    margin: 0 0 1 0;
}

.action-buttons-row Button {
    width: 1fr;
    height: 3;
    margin: 0 1 0 0;
}

#action-log {
    height: 1fr;
    min-height: 12;
}

/* === Wizard screen === */

#wizard-container {
    layout: vertical;
    padding: 2 4;
    overflow-y: auto;
}

.wizard-step {
    border: round $border;
    background: $surface-alt;
    padding: 2 3;
    margin: 1 0;
}

.wizard-step .step-title {
    text-style: bold;
    color: $accent;
    margin-bottom: 1;
}

.wizard-step .step-description {
    color: $text-muted;
    margin-bottom: 1;
}

#wizard-nav {
    dock: bottom;
    height: 3;
    layout: horizontal;
    padding: 0 4;
    background: $surface;
}

#wizard-nav Button {
    margin: 0 1;
    min-width: 14;
}

/* === Buttons === */

Button {
    background: $primary-muted;
    color: $text;
    border: tall $border;
    min-width: 10;
}

Button:hover {
    background: $primary;
    color: $text;
    border: tall $primary-light;
}

Button:focus {
    border: tall $accent;
    text-style: bold;
}

Button.-primary {
    background: $primary;
    color: white;
    text-style: bold;
}

Button.-primary:hover {
    background: $primary-light;
    color: $surface;
}

Button.-success {
    background: $success;
    color: $surface;
    text-style: bold;
}

Button.-error {
    background: $error;
    color: white;
    text-style: bold;
}

/* === DataTable === */

DataTable {
    margin: 1 0;
    height: auto;
    max-height: 15;
    background: $surface-alt;
}

DataTable > .datatable--header {
    background: $primary-muted;
    color: $accent;
    text-style: bold;
}

DataTable > .datatable--cursor {
    background: $primary;
    color: $text;
}

/* === Input === */

Input {
    background: $surface;
    color: $text;
    border: tall $border;
}

Input:focus {
    border: tall $primary;
}

/* === Select === */

Select {
    background: $surface;
    color: $text;
    border: tall $border;
}

Select:focus {
    border: tall $primary;
}

/* === Switch === */

Switch {
    background: $surface;
}

/* === Tabs (screen navigation) === */

TabbedContent {
    height: 1fr;
}

TabPane {
    padding: 0;
}

Tabs {
    background: $primary-muted;
    dock: top;
}

Tab {
    color: $text-muted;
    padding: 0 3;
}

Tab.-active {
    color: $text;
    text-style: bold;
    background: $primary;
}

Tab:hover {
    color: $text;
    background: $primary;
}

/* === Toast === */

Toast {
    background: $surface-alt;
    color: $text;
    border: tall $border;
}

/* === Help overlay === */

#help-overlay {
    align: center middle;
    width: 60;
    height: auto;
    max-height: 80%;
    background: $surface-alt;
    border: round $accent;
    padding: 2 3;
    layer: overlay;
}

#help-overlay .help-title {
    text-style: bold;
    color: $accent;
    text-align: center;
    margin-bottom: 1;
}

#help-overlay DataTable {
    background: $surface-alt;
    max-height: 20;
}
